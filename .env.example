# Public site URL (used for metadata, sitemap and Open Graph).
# Must be the address the site is actually served on. eoncodigital.com
# redirects to www, so use the www version or canonicals point at a redirect.
NEXT_PUBLIC_SITE_URL=https://www.eoncodigital.com

# Analytics and tracking (each one is skipped when empty)
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (the content="..." value only)
GOOGLE_SITE_VERIFICATION=
# HubSpot tracking code uses HUBSPOT_PORTAL_ID below. Set to "eu1" if your
# HubSpot account is hosted in the EU data centre.
HUBSPOT_REGION=

# HubSpot meetings link for the "Book a call" / Schedule Meeting page
# e.g. https://meetings.hubspot.com/your-name/consultation
NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=

# HubSpot Forms API (server side). When both are set, contact and project
# inquiry forms submit to HubSpot. Leave empty to run in demo mode.
HUBSPOT_PORTAL_ID=
HUBSPOT_CONTACT_FORM_GUID=
HUBSPOT_PROJECT_FORM_GUID=

# Headless WordPress (see WORDPRESS.md). When set, blog posts, projects
# (case studies) and testimonials come from this WordPress site.
# Leave empty to use the built-in sample content.
# e.g. https://cms.eoncodigital.com  (no trailing slash)
WORDPRESS_URL=

# Shared secret the WordPress plugin sends to /api/revalidate so new content
# appears within seconds. Use a long random string and paste the same value
# into WordPress → Settings → Eonco Website → Refresh secret.
REVALIDATE_SECRET=
