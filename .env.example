# Public site URL (used for metadata, sitemap and Open Graph).
# Must be the address the site is actually served on (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://takesolutiontoday.com

# Analytics and tracking (each one is skipped when empty)
# GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification code (the content="..." value only)
GOOGLE_SITE_VERIFICATION=
# HubSpot account. Defaults (src/content/site.ts) are portal 243233455 in the
# na2 data centre, taken from the embed code js-na2.hs-scripts.com/243233455.js.
# Only set these to override. Region: na1, na2, eu1, ...
HUBSPOT_PORTAL_ID=
HUBSPOT_REGION=

# HubSpot meetings link for the Schedule Meeting page
# (default: https://meetings-na2.hubspot.com/habibur-rahman)
NEXT_PUBLIC_HUBSPOT_MEETINGS_URL=

# HubSpot form IDs. Created and filled in automatically by `npm run hubspot:setup`.
# Without them, the forms run in demo mode (validated but not sent to HubSpot).
HUBSPOT_CONTACT_FORM_GUID=
HUBSPOT_PROJECT_FORM_GUID=

# LOCAL ONLY (never add to Vercel): Private App token used once by
# `npm run hubspot:setup` to create the forms and properties.
# Scopes: forms, crm.schemas.contacts.read, crm.schemas.contacts.write
HUBSPOT_ACCESS_TOKEN=

# Headless WordPress (see WORDPRESS.md). When set, blog posts, projects
# (case studies) and testimonials come from this WordPress site.
# Leave empty to use the built-in sample content.
# e.g. https://cms.takesolutiontoday.com  (no trailing slash)
WORDPRESS_URL=

# Shared secret the WordPress plugin sends to /api/revalidate so new content
# appears within seconds. Use a long random string and paste the same value
# into WordPress → Settings → Website Connection → Refresh secret.
REVALIDATE_SECRET=
